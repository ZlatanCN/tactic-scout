{
  "name": "tactiscout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "eval:player-identity": "node --import tsx src/evaluation/player-identity-cli.ts",
    "dev": "tsx watch src/index.ts",
    "dev:web": "pnpm --filter @tactiscout/web dev",
    "build": "tsc -p tsconfig.json",
    "build:web": "pnpm --filter @tactiscout/web build",
    "test": "node --import tsx --test $(find tests -name '*.test.ts' -print)",
    "test:recruitment-core": "node --import tsx --test tests/recruitment/recruitment-conversation.test.ts tests/recruitment/recruitment-cancellation.test.ts tests/recruitment/replacement-target.test.ts tests/recruitment/candidate-search-freshness-ablation.test.ts tests/recruitment/recruitment-evidence-evaluator-ablation.test.ts tests/recruitment/recruitment-comparison.test.ts tests/recruitment/methodology-reuse-ablation.test.ts",
    "eval:local-agent": "node --import tsx src/evaluation/local-model-agent.ts",
    "eval:methodology-rag": "node --import tsx src/evaluation/methodology-rag-cli.ts",
    "eval:methodology-rag:v3": "node --import tsx src/evaluation/methodology-rag-v3-cli.ts",
    "eval:methodology-rag:v4": "node --import tsx src/evaluation/methodology-rag-v4-cli.ts",
    "eval:methodology-rag:v5": "node --import tsx src/evaluation/methodology-rag-v5-cli.ts",
    "eval:shortlist-quality": "node --import tsx src/evaluation/shortlist-quality-cli.ts",
    "export:shortlist-review": "node --import tsx src/evaluation/blinded-review-packet-cli.ts",
    "knowledge:discover": "tsx src/knowledge/cli.ts discover",
    "knowledge:ingest": "tsx src/knowledge/cli.ts ingest",
    "knowledge:crawl": "tsx src/knowledge/cli.ts crawl",
    "knowledge:purge-source": "tsx src/knowledge/cli.ts purge-source",
    "identity:reep": "tsx src/players/identity/cli.ts",
    "dataset:build": "node --import tsx src/datasets/build-cli.ts",
    "dataset:import:fm": "node --import tsx src/sources/fm/import-cli.ts",
    "dataset:refresh": "node --import tsx src/datasets/refresh-cli.ts",
    "dataset:refresh:skillcorner": "node --import tsx src/datasets/refresh-skillcorner-cli.ts",
    "source:smoke:api-football": "node --import tsx src/sources/api-football/smoke-cli.ts",
    "source:smoke:openscores": "node --import tsx src/sources/openscores/smoke-cli.ts",
    "source:smoke:pitchapi": "node --import tsx src/sources/pitchapi/smoke-cli.ts",
    "source:smoke:soccersapi": "node --import tsx src/sources/soccersapi/smoke-cli.ts",
    "source:smoke:sportmonks": "node --import tsx src/sources/sportmonks/smoke-cli.ts",
    "start": "node dist/index.js",
    "eval:agent-optimization": "node --import tsx src/evaluation/agent-optimization-cli.ts",
    "eval:fm-fusion": "node --import tsx src/evaluation/fm-fusion-cli.ts",
    "export:fm-review": "node --import tsx src/evaluation/fm-fusion-review-cli.ts",
    "eval:recruitment-understanding": "node --import tsx src/evaluation/recruitment-understanding-cli.ts",
    "eval:recruitment-mechanisms": "node --import tsx src/evaluation/recruitment-mechanisms-cli.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@lancedb/lancedb": "^0.39.0",
    "@langchain/core": "^1.2.13",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/openai": "^1.6.0",
    "apache-arrow": "18.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}

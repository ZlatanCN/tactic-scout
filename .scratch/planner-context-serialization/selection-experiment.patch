+export function confirmedBriefPresentation(brief: RecruitmentBrief) {
+  const target = brief.targetTeam ? `为${brief.targetTeam.value}` : "";
+  const task = brief.task === "replacement" ? `寻找${brief.referencePlayer?.value ?? "参考球员"}的替代者`
+    : brief.task === "similarity" ? `寻找与${brief.referencePlayer?.value ?? "参考球员"}相似的球员` : "寻找补强候选";
+  const capabilityProfile = brief.priorities.map(({ value }) => value).slice(0, 8);
+  const requirements = [
+    brief.positions.length ? `位置：${brief.positions.join("、")}` : "",
+    ...capabilityProfile,
+    ...brief.constraints.map(({ strength, requirement }) => `${strength === "preferred" ? "偏好" : "要求"}：${requirement.value}`),
+  ].filter(Boolean);
+  return { needSummary: `${target}${task}${requirements.length ? `；${requirements.join("；")}` : ""}`.slice(0, 500), capabilityProfile };
+}
 

# demo | curated | statsbomb | sportmonks | skillcorner | wyscout | asa | understat | mosaic
# premier_league is intentionally blocked from Agent turns until source permissions are confirmed.
# Start with clearly labeled demo data; use Wyscout only after local files are present.
TACTISCOUT_DATA_MODE=demo

# Understat, ASA, and mosaic turns require OPENAI_BASE_URL to use a loopback host while source model-processing permissions remain unverified.
# The runtime rejects remote model endpoints before reading a case or player data.
# Anonymous ASA men's current-season performance pool: MLS, USL Championship, and USL League One.
# MLS Next Pro is excluded when the API result exceeds the completeness ceiling.
# It is not a complete registration roster or transfer-market feed.
TACTISCOUT_ASA_CACHE_TTL_MS=

# Current-season Big Five performance pool scraped sequentially from Understat's public league pages.
# This is a current-performance sample, not a full registration roster or transfer-market feed.
# The page-backed JSON route is undocumented and may change; successful raw responses are cached in SQLite.
TACTISCOUT_UNDERSTAT_CACHE_TTL_MS=
TACTISCOUT_UNDERSTAT_DB_PATH=./.data/understat/understat.sqlite

# Path to either the StatsBomb Open Data repository root or its data/ directory.
# The loader includes only competition-season entries marked competition_gender=male in competitions.json; missing/unknown gender is excluded.
TACTISCOUT_STATSBOMB_DIR=./data/statsbomb-open-data
TACTISCOUT_STATSBOMB_COMPETITION_IDS=
TACTISCOUT_STATSBOMB_SEASON_IDS=
# Keep false until the User Agreement has been reviewed. StatsBomb Agent turns also require OPENAI_BASE_URL to use a loopback host.
TACTISCOUT_STATSBOMB_AI_PROCESSING_ALLOWED=false

# Optional current player provider. Season IDs must be marked current by Sportmonks.
# Keep this token on the API server; do not place it in web/ configuration or logs.
SPORTMONKS_API_TOKEN=
TACTISCOUT_SPORTMONKS_SEASON_IDS=
# Optional one-team, no-model account smoke; stops before player requests unless the season is current.
TACTISCOUT_SPORTMONKS_SMOKE_SEASON_ID=
# Only include statistic type IDs confirmed as covered by the configured account and league.
# Supported mappings: 52 goals, 79 assists, 80 passes, 81/116 completed passes,
# 78 tackles, 100 interceptions, 119 minutes played, 122 long balls.
TACTISCOUT_SPORTMONKS_COVERED_STATISTIC_TYPE_IDS=
# Must stay false until the configured provider terms/account permit model processing.
TACTISCOUT_SPORTMONKS_AI_PROCESSING_ALLOWED=false
# In-memory cache lifetime; default is 15 minutes.
TACTISCOUT_SPORTMONKS_CACHE_TTL_MS=

# Optional historical SkillCorner Open Data sample. Run
# `pnpm dataset:refresh:skillcorner` to fetch the pinned aggregate CSVs here.
# The provider reads only local files and never bundles player data.
TACTISCOUT_SKILLCORNER_AGGREGATES_DIR=./.data/skillcorner-open-data/aggregates
# Enable only after confirming each use is permitted for the data you provide.
TACTISCOUT_SKILLCORNER_LOCAL_STORAGE_ALLOWED=false
TACTISCOUT_SKILLCORNER_AI_PROCESSING_ALLOWED=false
TACTISCOUT_SKILLCORNER_REPORT_DISPLAY_ALLOWED=false

# Historical Wyscout Open Data sample. `pnpm dataset:refresh` retrieves the pinned
# Figshare releases, verifies checksums, and builds a local snapshot. Raw files stay
# under the Git-ignored .data directory and are never committed.
TACTISCOUT_WYSCOUT_DIR=./.data/wyscout-open-data
# Generated, versioned TactiScout snapshots stay under the ignored local .data directory.
TACTISCOUT_DATASET_OUTPUT_DIR=./.data/tactiscout-datasets
TACTISCOUT_DATASET_FILE=./.data/tactiscout-datasets/latest.json
# Comma-separated Wyscout club competition IDs; empty means all club competitions in the files.
TACTISCOUT_WYSCOUT_COMPETITION_IDS=
# Curated snapshots based on Wyscout use the same explicit model-processing opt-in.
# Keep false until the configured local/remote model's use is explicitly confirmed.
TACTISCOUT_WYSCOUT_AI_PROCESSING_ALLOWED=false

# Optional PlayerElo external performance signal. The key stays on the API server.
# Signals are attached after evidence review and are never sent to the LLM.
PLAYER_ELO_API_KEY=
# Keep false until report display is allowed by the configured PlayerElo plan/terms.
TACTISCOUT_PLAYER_ELO_REPORT_DISPLAY_ALLOWED=false
# Reports are retained in LangGraph's local SQLite checkpoint and browser localStorage.
# Keep false until this local retention is allowed by the configured PlayerElo plan/terms.
TACTISCOUT_PLAYER_ELO_LOCAL_RETENTION_ALLOWED=false

# Optional post-review TheSportsDB team-roster context. Disabled by default and
# kept out of LangGraph state, scoring, reports saved to localStorage, and model input.
# For local development only, TheSportsDB documents the developer key `123`.
# Published apps/services require an eligible paid plan and source attribution.
TACTISCOUT_THESPORTSDB_ENABLED=false
TACTISCOUT_THESPORTSDB_API_KEY=
TACTISCOUT_THESPORTSDB_PAID_USE_ALLOWED=false

# Optional local Reep identity index. It is populated only by the explicit CLI;
# no Reep API calls or snapshot downloads happen automatically.
TACTISCOUT_REEP_IDENTITY_DB_PATH=./.data/reep/identity.sqlite
# 可选：本机导入的 schema 2 能力画像；关联索引需包含 fm/player 桥接。
# TACTISCOUT_FM_PROFILES_PATH=./.data/fm/profiles-v2.sqlite

# Optional post-review Wyscout archive context. These records stay out of LLM input,
# capability scoring and candidate ordering. Both permissions are required because
# reports are retained in the local LangGraph checkpoint and browser localStorage.
TACTISCOUT_WYSCOUT_ARCHIVE_DIR=./.data/wyscout-open-data
TACTISCOUT_WYSCOUT_HISTORICAL_REPORT_DISPLAY_ALLOWED=false
TACTISCOUT_WYSCOUT_HISTORICAL_LOCAL_RETENTION_ALLOWED=false

# Optional JSON file keyed by StatsBomb player ID, e.g. {"12345":{"age":22,"source":"football-data.org"}}
TACTISCOUT_DEMOGRAPHICS_FILE=

# OpenAI-compatible conversation agent; credentials stay on the API server.
# Local Ollama: create the 16K profile with `ollama create tactiscout-qwen3.5:9b -f config/ollama/Modelfile`.
# Use OPENAI_MODEL=tactiscout-qwen3.5:9b, OPENAI_API_KEY=ollama, OPENAI_BASE_URL=http://127.0.0.1:11434/v1/
# See README for the complete model example. Ollama ignores the placeholder key.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# Auto uses JSON Schema for the standard local Ollama endpoint and function calling elsewhere.
OPENAI_STRUCTURED_OUTPUT_METHOD=auto
# Maximum time per model decision (1000–600000 ms; default 180000); model calls do not retry implicitly.
OPENAI_TIMEOUT_MS=180000
# Maximum generated tokens per planner response. A complete report action may
# include several evidence-backed leads; default is 8192.
OPENAI_MAX_OUTPUT_TOKENS=8192
# Candidate expansion is a small structured decision; default 1024, never above the general budget.
OPENAI_EXPANSION_MAX_OUTPUT_TOKENS=1024
# Bound candidate-expansion decisions to 60 seconds by default, never above the general timeout.
OPENAI_EXPANSION_TIMEOUT_MS=60000
# Optional model-specific reasoning control. Set to `none` for Ollama Qwen models.
OPENAI_REASONING_EFFORT=

# Local LangGraph checkpoints for paused recruitment cases (separate from browser localStorage plans).
# Keep the SQLite file on local disk for the single API process used by this prototype.
TACTISCOUT_CHECKPOINT_PATH=./.data/recruitment-cases.sqlite

# Optional one-page, local-only API-Football coverage smoke; this does not enable a provider in the app.
API_FOOTBALL_API_KEY=
API_FOOTBALL_LEAGUE_ID=
API_FOOTBALL_SEASON=2026

# Optional local-only PitchAPI smoke. This does not enable an app provider, persist data, or call an LLM.
# Keep the key on the API server. Rights for display, storage, and model use need separate confirmation.
PITCHAPI_API_KEY=
TACTISCOUT_PITCHAPI_LEAGUE_NAME=Premier League
TACTISCOUT_PITCHAPI_COUNTRY_CODE=ENG

# Optional local-only OpenScores MCP smoke; checks one globally searched team profile.
# This does not enable the source in LangGraph, persist player data, or call a model.
OPENSCORES_API_KEY=
TACTISCOUT_OPENSCORES_TEAM_NAME=Arsenal

# Optional local-only SoccersAPI development-key smoke; it does not enable an app provider.
# The free plan exposes up to three account-selected leagues and has a daily request allowance.
SOCCERSAPI_API_KEY=
TACTISCOUT_SOCCERSAPI_LEAGUE_NAME=Premier League
TACTISCOUT_SOCCERSAPI_COUNTRY_CODE=ENG
TACTISCOUT_SOCCERSAPI_TEAM_NAME=

# Local server-side RAG index and multilingual E5 ONNX q8 embedding model.
# Quantized model weights are downloaded and cached on first RAG query.
TACTISCOUT_KNOWLEDGE_DIR=./.data/knowledge
TACTISCOUT_KNOWLEDGE_SOURCES_FILE=./data/knowledge/sources.json
TACTISCOUT_PLAYER_OBSERVATIONS_PATH=./.data/player-observations.json
TACTISCOUT_EMBEDDING_MODEL=onnx-community/multilingual-e5-base-ONNX
# Optional remote embeddings. Local Transformers.js remains the default.
TACTISCOUT_EMBEDDING_PROVIDER=local
TACTISCOUT_EMBEDDING_API_KEY=
TACTISCOUT_EMBEDDING_BASE_URL=
TACTISCOUT_REMOTE_EMBEDDING_MODEL=text-embedding-3-small

# Optional Tavily Web Search for qualitative capability gaps. Searches up to four
# basic results and does not crawl or persist original pages. Keep disabled until
# the selected publishers' AI processing, report display, and local retention
# terms have been checked. Domains are publisher host scopes, comma-separated.
TAVILY_API_KEY=
# Only sends the reference mention to Tavily when Wikidata cannot uniquely confirm it.
# A single result continues only when the same name appears on at least two HTTPS hosts
# and Wikidata verifies the entity as a footballer; multiple entities require confirmation.
TACTISCOUT_TAVILY_IDENTITY_SEARCH_ENABLED=false
TACTISCOUT_WEB_SEARCH_ALLOWED_DOMAINS=
TACTISCOUT_WEB_SEARCH_AI_PROCESSING_ALLOWED=false
TACTISCOUT_WEB_SEARCH_REPORT_DISPLAY_ALLOWED=false
TACTISCOUT_WEB_SEARCH_LOCAL_RETENTION_ALLOWED=false

HOST=127.0.0.1
PORT=8000

# football-data.org: optional server-only roster context; cached locally for 24 hours.
TACTISCOUT_FOOTBALL_DATA_API_KEY=
# Optional persistent identity evidence ledger (verified aliases / scoped confirmations).
TACTISCOUT_NAME_EVIDENCE_PATH=.data/identity/name-evidence.sqlite
